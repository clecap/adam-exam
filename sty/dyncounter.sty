
%%
%% BEGIN Macros for managing dynamic counters
%%
%BEGIN_FOLD
\makeatletter


\newcommand\DynCtr@list{}% need to maintain a list of all created dynamic counters

% Register a dynamic counter in a list
\newcommand{\DynCtr@register}[1]{%
  \ifx\DynCtr@list\@empty
    \xdef\DynCtr@list{#1}%
  \else
    \xdef\DynCtr@list{\DynCtr@list,#1}%
  \fi
}

% EnsureDynCounter{#1}{#2}
% #1 = prefix of the counter family (string used as first part of the counter name)
% #2 = dynamic identifier appended to the prefix
% The macro checks whether the internal counter \c@#1@#2 exists.
% If it does not exist, a new LaTeX counter named "#1@#2" is created.

\newcommand{\EnsureDynCounter}[2]{%
  \@ifundefined{c@#1@#2}{%
    \newcounter{#1@#2}%
    \DynCtr@register{#1@#2}%
  }{}%
}

% StepDynCounter{#1}{#2}
% #1 = prefix of the counter family
% #2 = dynamic identifier
% First ensures that the counter "#1@#2" exists,
% then increments this counter by one.
\newcommand{\StepDynCounter}[2]{%
  \EnsureDynCounter{#1}{#2}%
  \stepcounter{#1@#2}%
}

% SetDynCounter{#1}{#2}{#3}
% #1 = prefix of the counter family
% #2 = dynamic identifier
% #3 = integer value assigned to the counter
% Ensures existence of counter "#1@#2",
% then sets its value to #3 (use #3=0 to reset).
\newcommand{\SetDynCounter}[3]{%
  \EnsureDynCounter{#1}{#2}%
  \setcounter{#1@#2}{#3}%
}


% AddDynCounter{#1}{#2}{#3}
% #1 = prefix of the counter family
% #2 = dynamic identifier
% #3 = integer value added to the counter
% Ensures existence of counter "#1@#2",
% then sets its value to #3 (use #3=0 to reset).
\newcommand{\AddDynCounter}[3]{%
  \EnsureDynCounter{#1}{#2}%
  \addtocounter{#1@#2}{#3}%
}


% GetDynCounter{#1}{#2}
% #1 = prefix of the counter family
% #2 = dynamic identifier
% Ensures existence of counter "#1@#2",
% then expands to the numeric value of that counter.
% The result is a pure number (no formatting).
\newcommand{\GetDynCounter}[2]{%
  \EnsureDynCounter{#1}{#2}%
  \number\value{#1@#2}%
}

% File handle for writing
\newwrite\DynCtrOut

% DynCtrOpen{#1}
% #1 = filename (e.g. dyncounters.dat)
\newcommand{\DynCtrOpen}[1]{%
  \immediate\openout\DynCtrOut=#1\relax
}

% DynCtrClose
\newcommand{\DynCtrClose}{%
  \immediate\closeout\DynCtrOut
}

% DynCtrWriteOne{#1}{#2}
% #1 = prefix (counter family)
% #2 = id
% Writes a line that, when read back, restores the counter value.
\newcommand{\DynCtrWriteOne}[2]{%
  \EnsureDynCounter{#1}{#2}%
  \begingroup
    \edef\Dyn@tmp{%
      \noexpand\SetDynCounter{#1}{#2}{\GetDynCounter{#1}{#2}}%
    }%
    \immediate\write\DynCtrOut{\Dyn@tmp}%
  \endgroup
}

% DynCtrReadFile{#1}
% #1 = filename previously written by DynCtrWriteOne
\newcommand{\DynCtrReadFile}[1]{%
  \input{#1}%
}

% reset all dynamic counters to zero

\newcommand{\ResetAllDynCounters}{%
  \begingroup
    \edef\Dyn@tmp{\DynCtr@list}%
    \@for\Dyn@ctr:=\Dyn@tmp\do{%
      \ifx\Dyn@ctr\@empty\else
        \setcounter{\Dyn@ctr}{0}%
      \fi
    }%
  \endgroup
}
\makeatother

%END_FOLD

